# n8n production stack configuration.
# Do not edit this file: run `scripts/init.sh` to generate .env with random secrets.
# Values marked CHANGE_ME are replaced by init.sh.

# --- Public endpoint ---------------------------------------------------------
# Domain pointing (A/AAAA) at this server. Caddy obtains the certificate for it.
N8N_HOST=n8n.example.com
# Contact e-mail for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com
TZ=UTC

# --- Versions (pinned; see README "Upgrading") -------------------------------
N8N_VERSION=2.46.6

# --- Secrets (generated by init.sh) ------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Shared by main, workers and webhook processors. BACK THIS UP: without it the
# credentials stored in the database cannot be decrypted.
N8N_ENCRYPTION_KEY=CHANGE_ME

# --- n8n tuning --------------------------------------------------------------
N8N_WORKER_REPLICAS=1
N8N_WORKER_CONCURRENCY=10
# Delete execution data older than this many hours (336 = 14 days).
EXECUTIONS_DATA_MAX_AGE=336
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false

# --- Optional dedicated webhook processor ------------------------------------
# To enable, uncomment all three and run `make up`:
# COMPOSE_PROFILES=webhook
# WEBHOOK_UPSTREAM=n8n-webhook:5678
# N8N_DISABLE_PRODUCTION_MAIN_PROCESS=true
# N8N_WEBHOOK_REPLICAS=1

# --- Backups -----------------------------------------------------------------
# Cron expression (container timezone = TZ). Default: every day at 03:00.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
# Run one backup when the backup container starts.
BACKUP_ON_START=false

# Optional S3-compatible upload (AWS S3, Backblaze B2, Cloudflare R2, MinIO, Wasabi ...).
# Leave BACKUP_S3_BUCKET empty to keep backups local only.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=n8n
BACKUP_S3_RETENTION_DAYS=30
S3_PROVIDER=AWS
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Resource limits (optional) ----------------------------------------------
# N8N_MAIN_CPUS=1.0
# N8N_MAIN_MEMORY=1g
# N8N_WORKER_CPUS=1.0
# N8N_WORKER_MEMORY=1g
# POSTGRES_MEMORY=1g
# REDIS_MAXMEMORY=256mb
